    "items": [
      {
        "title": "Death and Life of the Great Lakes",
        "creator": "Dan Egan",
        "lens": "Ecosystem",
        "isbn": "978-0393355550",
        "invitation": "Treat the inland seas as an engineered ecosystem and contested commons: commerce, invasive species, policy, repair, and the question of who gets to govern water.",
        "image": {
          "src": "images/frst/death-life-great-lakes.jpg",
          "alt": "Cover of The Death and Life of the Great Lakes by Dan Egan",
          "credit": "Cover via Open Library",
          "creditUrl": "https://openlibrary.org/works/OL20048562W/The_death_and_life_of_the_Great_Lakes"
        }
      },
      {
        "title": "Flood narratives",
        "creator": "Gilgamesh and Noah",
        "lens": "Myth",
        "invitation": "Set these ancient floods beside Yu and other water traditions: who is warned, what is saved, and what theory of order emerges after the water?",
        "image": {
          "src": "images/frst/flood-tablet.jpg",
          "alt": "The cuneiform Flood Tablet from the Epic of Gilgamesh",
          "credit": "Nate Loper · CC BY 2.0",
          "creditUrl": "https://commons.wikimedia.org/wiki/File:Epic_of_Gilgamesh_Flood_Tablet_in_Akkadian_Cuneiform_-_Nate_Loper_(28654515397).jpg"
        }
      },
      {
        "title": "Selection of music in the Delta Blues tradition",
        "creator": "Various musical artists",
        "lens": "Sound",
        "invitation": "Hear the Mississippi not as scenery but as land, labor, migration, dispossession, love, and loss—made audible in the Delta blues.",
        "image": {
          "src": "images/frst/delta-blues.jpg",
          "alt": "Portrait of Delta blues singer and guitarist Mississippi Fred McDowell",
          "credit": "Fred Seibert · CC BY-SA 2.0",
          "creditUrl": "https://commons.wikimedia.org/wiki/File:Mississippi_Fred_McDowell.jpg"
        }
      },
      {
        "title": "Blood Dazzler",
        "creator": "Patricia Smith",
        "lens": "Poetry",
        "isbn": "978-1566892186",
        "invitation": "Enter Katrina through shifting voices—including the storm itself—and confront racialized abandonment, failed infrastructure, and what poetry can witness that news cannot.",
        "image": {
          "src": "images/frst/blood-dazzler.jpg",
          "alt": "Cover of Blood Dazzler by Patricia Smith",
          "credit": "Cover via Open Library",
          "creditUrl": "https://openlibrary.org/books/OL16700983M/Blood_dazzler"
        }
      },
      {
        "title": "The Interesting Narrative",
        "creator": "Olaudah Equiano",
        "lens": "Testimony",
        "isbn": "978-0198707523",
        "invitation": "Cross an Atlantic made into a route for capital and forced migration in an autobiography, maritime adventure, and insurgent argument for abolition.",
        "image": {
          "src": "images/frst/interesting-narrative.jpg",
          "alt": "Oxford World's Classics cover of The Interesting Narrative by Olaudah Equiano",
          "credit": "Cover via Open Library",
          "creditUrl": "https://openlibrary.org/isbn/9780198707523"
        }
      },
      {
        "title": "Rising: New Dispatches from the American Shore",
